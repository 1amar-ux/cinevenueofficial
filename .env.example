# =============================================================
# CineVenue — Environment Variables
# Copy this file to .env and fill in your values.
# For Vercel: add these in Dashboard → Project → Settings → Environment Variables
# =============================================================

# -----------------------------------------------
# NODE / APP
# -----------------------------------------------
NODE_ENV=production
PORT=3000

# -----------------------------------------------
# SUPER ADMIN CREDENTIALS (set in Vercel env vars — never commit real values!)
# These control who can access /adminpanel
# -----------------------------------------------
VITE_SUPER_ADMIN_EMAIL=superadmin@yourdomain.com
VITE_SUPER_ADMIN_PASSWORD=YourStrongPasswordHere123!

# -----------------------------------------------
# DATABASE (PostgreSQL via Supabase / Neon / Railway)
# For Supabase: use the Pooler URL (Transaction mode) for DATABASE_URL
# and the Direct URL for DIRECT_URL (used by Prisma migrations)
# Supabase → Project Settings → Database → Connection String
# -----------------------------------------------
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# -----------------------------------------------
# SUPABASE
# Supabase → Project Settings → API
# -----------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-anon-key
SUPABASE_SECRET_KEY=your-service-role-key
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json

# -----------------------------------------------
# JWT SECRETS (use strong random strings in production)
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# -----------------------------------------------
JWT_ACCESS_SECRET=your_strong_access_secret_here
JWT_REFRESH_SECRET=your_strong_refresh_secret_here
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# -----------------------------------------------
# GOOGLE OAUTH
# Google Cloud Console → APIs & Services → Credentials
# Add your Vercel domain to Authorized redirect URIs:
# https://your-app.vercel.app/api/v1/auth/google/callback
# -----------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=https://your-app.vercel.app/api/v1/auth/google/callback

# -----------------------------------------------
# RAZORPAY PAYMENTS
# VITE_ prefix exposes the key to the React frontend
# -----------------------------------------------
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
VITE_RAZORPAY_KEY_ID=rzp_live_your_key_id

# -----------------------------------------------
# GEMINI AI
# -----------------------------------------------
GEMINI_API_KEY=your_gemini_api_key

# -----------------------------------------------
# CORS — set to your Vercel deployment URL in production
# -----------------------------------------------
CORS_ORIGIN=https://your-app.vercel.app
FRONTEND_URL=https://your-app.vercel.app

# -----------------------------------------------
# APP URL (used for self-referential links & OAuth callbacks)
# -----------------------------------------------
APP_URL=https://your-app.vercel.app

