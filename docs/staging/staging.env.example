# =========================================================================
# CineVenue — Authoritative Staging Environment Variables Template
# Copy this template to .env.staging or configure in your staging hosting dashboard.
# Strict sandbox configuration: all payment gateways are pinned to TEST mode.
# =========================================================================

# -------------------------------------------------------------------------
# 1. BUILD-TIME FRONTEND VARIABLES (Client-side exposed via Vite)
# -------------------------------------------------------------------------
VITE_API_URL=https://staging-api.cinevenue.com
VITE_CASHFREE_ENV=TEST

# -------------------------------------------------------------------------
# 2. REQUIRED BACKEND RUNTIME VARIABLES
# -------------------------------------------------------------------------
NODE_ENV=production
PORT=5000
API_PREFIX=/api/v1

# Strict CORS (comma-separated origins; NO WILDCARD '*' in production mode)
CORS_ORIGIN=https://staging.cinevenue.com,https://staging-app.cinevenue.com
FRONTEND_URL=https://staging.cinevenue.com

# High-Entropy JWT Secrets (Must be generated via: openssl rand -hex 32)
# Length must be >= 64 hex characters (32 bytes). Dev defaults are strictly rejected.
JWT_ACCESS_SECRET=replace_with_openssl_rand_hex_32_access_secret_64chars
JWT_REFRESH_SECRET=replace_with_openssl_rand_hex_32_refresh_secret_64chars
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Admin Credentials & Security Passcodes (Must NOT be '8888' or 'admin8888')
ADMIN_PASSCODE=StagingAdminPasscode2026!Secure
SUPER_ADMIN_PASSWORD=StagingSuperAdminPassword2026!Secure
SUPER_ADMIN_EMAIL=superadmin@cinevenue.com

# -------------------------------------------------------------------------
# 3. DATABASE (PostgreSQL) & DISTRIBUTED CACHE (Redis)
# -------------------------------------------------------------------------
# Direct TCP Connection String (Required for genuine Prisma transactions and ACID rollback)
DATABASE_URL=postgresql://postgres:[PASSWORD]@[STAGING_POSTGRES_HOST]:5432/cinevenue_staging?schema=public&connection_limit=20&pool_timeout=10

# Optional Direct URL for running Prisma migrations when using a connection pooler
DIRECT_URL=postgresql://postgres:[PASSWORD]@[STAGING_POSTGRES_HOST]:5432/cinevenue_staging?schema=public

# Shared Redis Cluster / Managed Instance (Upstash, AWS ElastiCache, or Redis Cloud)
# Required for multi-instance distributed seat locking (10-minute hold). Localhost is blocked in production.
REDIS_URL=redis://:[PASSWORD]@[STAGING_REDIS_HOST]:6379

# -------------------------------------------------------------------------
# 4. PAYMENT GATEWAYS — STRICTLY TEST / SANDBOX SIMULATION
# (Never set RAZORPAY_ENV=LIVE or CASHFREE_ENV=PROD in staging!)
# -------------------------------------------------------------------------
DEFAULT_PAYMENT_GATEWAY=RAZORPAY

# Razorpay Sandbox Mode
RAZORPAY_ENV=TEST
RAZORPAY_KEY_ID=rzp_test_YourStagingKeyIdHere
RAZORPAY_KEY_SECRET=YourStagingRazorpaySecretHere
RAZORPAY_WEBHOOK_SECRET=rzp_whsec_staging_test_secret_2026

# Cashfree Sandbox Mode (v2023-08-01)
CASHFREE_ENV=TEST
CASHFREE_APP_ID=TEST_YourStagingCashfreeAppId
CASHFREE_SECRET_KEY=cfsk_ma_test_YourStagingCashfreeSecret
CASHFREE_WEBHOOK_SECRET=cf_whsec_staging_test_secret_2026
CASHFREE_API_VERSION=2023-08-01

# -------------------------------------------------------------------------
# 5. PUSH NOTIFICATION PROVIDERS (FCM & APNs - OPTIONAL FOR STAGING)
# -------------------------------------------------------------------------
# Google Firebase Cloud Messaging (Android & Web)
FCM_SERVER_KEY=AAAA-Your-Staging-FCM-Server-Key-Here
FIREBASE_SERVICE_ACCOUNT_KEY=

# Apple Push Notification Service (iOS) - Uppercase required by Unix runtime
APNS_KEY_ID=10CHARKEYID
APNS_TEAM_ID=10CHARTEAMID
APNS_BUNDLE_ID=com.cinevenue.app.staging
APNS_AUTH_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----

# -------------------------------------------------------------------------
# 6. GOOGLE GEMINI AI VIP CONCIERGE (OPTIONAL FOR STAGING)
# -------------------------------------------------------------------------
GEMINI_API_KEY=AIzaSy-YourStagingGeminiApiKeyHere

# -------------------------------------------------------------------------
# 7. GOOGLE OAUTH 2.0 (OPTIONAL FOR STAGING)
# -------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-staging-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-staging-client-secret
GOOGLE_CALLBACK_URL=https://staging.cinevenue.com/api/v1/auth/google/callback

# -------------------------------------------------------------------------
# 8. EMAIL DELIVERY (SMTP / RESEND - OPTIONAL FOR STAGING)
# -------------------------------------------------------------------------
RESEND_API_KEY=re_staging_test_key_here
RESEND_FROM=tickets@staging.cinevenue.com
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_mailtrap_user
SMTP_PASSWORD=your_mailtrap_password
SMTP_SECURE=false
SMTP_FROM=tickets@staging.cinevenue.com
