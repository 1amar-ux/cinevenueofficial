# ==========================================
# CINEVENUE FLUTTER MOBILE ENVIRONMENT TEMPLATE
# Copy to .env and configure for your target environment.
# DO NOT COMMIT SENSITIVE PRODUCTION CREDENTIALS.
# ==========================================

# 1. Backend REST API URL
# Local Development:
# - Android Emulator: http://10.0.2.2:3000/api/v1
# - iOS Simulator: http://127.0.0.1:3000/api/v1
# - Physical Device (Local Wi-Fi): http://192.168.1.X:3000/api/v1
# Production / Staging:
API_BASE_URL=https://cinevenue.com/api/v1

# 2. Payment Gateway Client Keys (Public Non-Secret Keys)
# Razorpay Key ID (rzp_test_... or rzp_live_...)
RAZORPAY_KEY_ID=rzp_test_placeholder

# Cashfree Environment: 'TEST' or 'PROD'
CASHFREE_ENV=TEST

# 3. Google Sign-In Client IDs
# Google Web Client ID for Backend Token Verification
GOOGLE_SERVER_CLIENT_ID=your-google-server-client-id.apps.googleusercontent.com

# iOS Client ID
GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com

# 4. App Configuration
APP_NAME=CineVenue
APP_ENV=development
API_CONNECT_TIMEOUT_MS=15000
API_RECEIVE_TIMEOUT_MS=15000

